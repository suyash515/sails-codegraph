{
  "name": "sails-codegraph",
  "version": "0.1.0",
  "description": "Static, local-first code graph for Sails.js applications with a CLI and an MCP stdio server.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sails-codegraph": "dist/cli/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sails-codegraph.config.schema.json": "./sails-codegraph.config.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "sails-codegraph.config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "sails",
    "sailsjs",
    "code-graph",
    "mcp",
    "static-analysis"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "test": "npm run build && node --test --test-concurrency=4 \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:pack": "npm run build && node --test \"tests/packaging/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.3",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5"
  }
}
